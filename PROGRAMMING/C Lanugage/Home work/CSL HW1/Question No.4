#include<stdio.h>
#include<math.h>

int main () {


        int a,b,c;
        double D,e,f;
        printf("a=");
        scanf("%d",&a);
        printf("b=");
        scanf("%d",&b);
        printf("c=");
        scanf("%d",&c);

        printf("%dx^2+%dx+%d=0\n",a,b,c);
        D=b*b-4*a*c;
        if(D==0) {
                e=(-b+sqrt(D))/2*a;
                f=(-b-sqrt(D))/2*a;
                e=f;
                printf("the roots are same\n");
                printf("the roots of the eqn is %f\n",f);
        }
        else if(D>0) {
                e=(-b+sqrt(D))/2*a;
                f=(-b-sqrt(D))/2*a;
                printf("the roots are not same\n");
                printf("the roots of the eqn are %f and %f\n",e,f);
        }
        else if(D<0)
                printf("the roots are not real\n");

        return 0;

}

