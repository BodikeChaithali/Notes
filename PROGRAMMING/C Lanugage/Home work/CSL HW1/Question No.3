#include<stdio.h>
int main()
{
      float marks;
      int grade;
      printf("enter the marks between 0 to 100:");
      scanf("%f",&marks);

      if(marks<0 || marks>100){ printf("invalid marks");
            return 1;}

      if(marks>=86){ grade=1;  }
      else if(marks>=71) { grade=2; }
      else if(marks>=56){ grade=3;  }
      else if(marks>=41) { grade=4;  }
      else if(marks>=26) { grade=5;  }
      else { grade=6;  }

      switch(grade){
    case 1:printf("A+\n"); break;
    case 2: printf("A-\n");break;
    case 3: printf("B+\n"); break;
    case 4: printf("B-\n"); break;
    case 5: printf("C\n"); break;
    case 6: printf("F\n");
      }
}

