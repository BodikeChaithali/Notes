#include<stdio.h>

int main () {

        int n,r=0;
        printf("entr n digit number:");
        scanf("%d",&n);

        if(n % 10 ==0) {
                printf("n digit number ending with zero\n");
        }
        else {
                while (n!=0) {
                        int d = n%10;
                        r=r*10+d;
                        n=n/10;
                        }
                printf("revere of the number is %d \n",r);

        }
        return 0;
}

