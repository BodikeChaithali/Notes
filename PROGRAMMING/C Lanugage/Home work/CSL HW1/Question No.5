#include <stdio.h>

void printPattern(int n) {
    int i, j;

    for (i = 1; i <= n; i++) {
        for (j = 1; j <= i; j++) {
            printf("#");
        }

        for (j = 1; j <= 2 * (n - i); j++) {
            printf(" ");
        }

        for (j = 1; j <= i; j++) {
            printf("#");
        }
        printf("\n");
    }

    for (i = n; i >= 1; i--) {
        for (j = 1; j <= i; j++) {
            printf("#");
        }

        for (j = 1; j <= 2 * (n - i); j++) {
            printf(" ");
        }

        for (j = 1; j <= i; j++) {
            printf("#");
        }
        printf("\n");
    }
}

int main() {
int n;

    printf("Enter a positive integer: ");
    scanf("%d", &n);

printPattern(n);

    return 0;
}

