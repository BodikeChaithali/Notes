#include <stdio.h>

int is_prime(int num) {
    if (num < 2) {
        return 0;
    }
    for (int i = 2; i * i <= num; i++) {
        if (num % i == 0) {
            return 0;
        }
    }
    return 1;
}

int main() {
    int n;
    printf("Enter a positive integer n: ");
    scanf("%d", &n);

    int limit = n * n;
    int p[limit];
    //p -  prime
    int c = 0;
    int a = 2;
    while (c < limit) {
        if (is_prime(a)) {
            p[c] = a;
            c++;
        }
        a++;
    }
    for (int i = 0; i < limit; i++) {
        printf("%5d ", p[i]);
        if ((i + 1) % n == 0) {
            printf("\n");
        }
    }
    return 0;
}

