#include <stdio.h>

int minCost(int cost[], int n)
 {
    if (n == 0 || n == 1)
     {
        return cost[0];
     }

    int dp[n];
    dp[0] = cost[0];
    dp[1] = cost[1];

    for (int i = 2; i < n; i++)
     {
        dp[i] = cost[i] + ((dp[i - 1] < dp[i - 2]) ? dp[i - 1] : dp[i - 2]);
    }

    return dp[n - 1] < dp[n - 2] ? dp[n - 1] : dp[n - 2];
}

int main()
 {
    int n;
    printf("Enter the number of steps: ");
    scanf("%d", &n);

    int cost[n];
    printf("Enter the cost of each step:\n");
    for (int i = 0; i < n; i++) 
    {
        scanf("%d", &cost[i]);
    }

    printf("Minimum cost: %d\n", minCost(cost, n));

    return 0;
}
