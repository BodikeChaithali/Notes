#include <stdio.h>

int main() 
{
    int A[7];  
    int I[6];  
    printf("Enter 7 distinct non-negative integers:\n");
    for (int i = 0; i < 7; i++) 
    {
        scanf("%d", &A[i]);
    }
    I[0] = 0;  
    for (int i = 1; i < 7; i++) 
    {
        int count = 0;  
        for (int j = 0; j < i; j++)
         {
            if (A[j] > A[i]) 
            {
                count++;
            }
        }
        I[i - 1] = count; 
    }

   
    printf("Inversion vector:\n");
    for (int i = 0; i < 6; i++) 
    {
        printf("%d\t", I[i]);
    }
    printf("\n");

    return 0;
}
