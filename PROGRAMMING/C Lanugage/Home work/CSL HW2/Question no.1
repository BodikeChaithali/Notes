#include<stdio.h>


int isprime(int num)
{
        if(num<=1)
        {
                return 0;
        }
  for(int i=2;i*i<=num;i++)
  {
          if(num%i==0)
          {
                  return 0;
          }
  }
         return 1;
}
int islefttruncatable(int num)
{
        int divisor=1;

    while(divisor<=num)
    {
            divisor*=10;
    }

      divisor=divisor/10;

      while(divisor>0)
      {
              if(!isprime(num))
                      return 0;
              else
              {
                     num= num% divisor;
                     divisor= divisor/10;
              }
      }
                     return 1;
    }


int isrighttruncatable(int num)
{
        while(num>0)
        {
                if(!isprime(num))
                        return 0;
                else
                        num=num/10;
        }
       return 1;
}

int main()
{
     int n;
     printf("enter a number");
     scanf("%d",&n);
     int lefttruncatable_number= islefttruncatable(n);
     int righttruncatable_number= isrighttruncatable(n);

    if(lefttruncatable_number && righttruncatable_number)
    {
            printf("the number %d is both lefttruncatable number and righttruncatable number\n",n);
    }
    else if(lefttruncatable_number)
    {
            printf("the number %d is only lefttruncatable number\n",n);
    }
    else if(righttruncatable_number)
    {
            printf("the number %d is only righttruncatable number\n",n);
    }
    else
    {
            printf("neither lefttruncatable nor righttruncatable\n");
    }
    return 0;
}


