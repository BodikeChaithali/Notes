#include <stdio.h>

int findElement(int A[], int n) 
{
    int total_sum = 0;
    int left_sum = 0;
    int i;
    for (i = 0; i < n; i++) 
    {
        total_sum += A[i];
    }
    for (i = 0; i < n; i++)
     {
        if (left_sum == total_sum - left_sum - A[i])
         {
            return 1;
        }
        left_sum += A[i];
    }
    return 0;
}

int main() 
{
    int n;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int A[n];

    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) 
    {
        scanf("%d", &A[i]);
    }

    int result = findElement(A, n);

    if (result == 1)
    {
        printf("Element found with equal left and right sums\n");
    }
    else
    {
        printf("No element found with equal left and right sums\n");
    }

    return 0;
}
